# Environment Variables for PP Cafe Loyalty App
# Copy this file to .env.local and fill in the values

# ─── Supabase ───────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Your Project → Settings → Database
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# ─── Database (Prisma) ───────────────────────────────────────────────────────
# Get these from: Supabase → Settings → Database → Connection string
# Use "Transaction" mode (port 6543) for DATABASE_URL (connection pooling)
DATABASE_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Use "Session" mode (port 5432) for DIRECT_URL (migrations)
DIRECT_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ─── Session ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
SESSION_SECRET="your-secret-key-min-32-chars-long-change-this"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="PP Cafe"
STAMPS_REQUIRED=10
